{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "maxTelemetryItemsPerSecond": 5,
        "excludedTypes": "Exception"
      }
    },
    "logLevel": {
      "default": "Warning",
      "Function": "Warning",
      "Host.Results": "Warning",
      "HourlyPriceAlerts": "Information"
    }
  }
}
